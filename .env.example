# =============================================================================
# EstateVista India - Environment Configuration Template
# Duplicate this file as '.env' on your production server.
# NEVER commit the actual '.env' containing production credentials to VCS.
# =============================================================================

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false

# Canonical Base URL (Leave empty for dynamic auto-detection)
# SITE_URL=https://www.estatevistaindia.com

# Database Connection (MySQL 8.0+ / MariaDB 10.4+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=estatevista_db
DB_USER=estatevista_user
DB_PASS=YourSecureProductionPasswordHere
DB_CHARSET=utf8mb4

# Concierge & Statutory Advisory Details
SITE_EMAIL=concierge@estatevistaindia.com
SITE_PHONE="+91 22 6985 4000"
SITE_WHATSAPP="+91 98200 12345"
RERA_REGISTRATION="MAHARERA Reg. No: A51900038921 | Certified Luxury Advisory"

# Optional Outbound SMTP Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@estatevistaindia.com
SMTP_PASS=
SMTP_SECURE=tls
