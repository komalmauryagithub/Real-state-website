# =============================================================================
# EstateVista India - Git Ignore Rules
# =============================================================================

# 1. Environment Configuration & Secrets (Never commit credentials)
.env
.env.local
.env.*.local
*.env

# 2. User Uploaded Files (Preserve folder structure & security rules)
/uploads/*
!/uploads/.htaccess
!/uploads/.gitkeep
/assets/uploads/*
!/assets/uploads/.gitkeep

# 3. Scratch & Temporary Application Artifacts
/scratch/
/.system_generated/
*.log
*.tmp
*.bak
*.swp
*~

# 4. Database Backups & Dynamic Dumps (Keep schema.sql & seed.sql)
*.sql.bak
*.sql.gz
/database/backups/
/database/dumps/
backup_*.sql

# 5. Dependency Directories (Composer & Node)
/vendor/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. Docker Local Volumes & Data Mounts
mysql_data/
db_data/
docker-compose.override.yml
.docker/

# 7. IDE & Editor Specific Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# 8. Operating System Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 9. Test & Coverage Reports
.phpunit.result.cache
/coverage/
